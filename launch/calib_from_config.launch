<launch>
  <arg name="config_file" default="$(find fast_calib)/config/sensor_suite_robosense_helios_d455.yaml" />
  <arg name="rviz" default="true" />

  <rosparam file="$(arg config_file)" command="load" subst_value="true" />

  <node pkg="fast_calib" type="fast_calib" name="fast_calib" output="screen" />

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_calib)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
